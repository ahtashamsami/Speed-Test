{
  "manifest_version": 3,
  "name": "Testline Speed Test",
  "version": "1.0.0",
  "description": "Compact 3D speed test popup to measure live download and upload speeds and export a PDF diagnostic report.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://speed.cloudflare.com/*",
    "https://ipwho.is/*",
    "https://get.geojs.io/*",
    "https://api.ipify.org/*",
    "https://api64.ipify.org/*",
    "https://cloudflare-dns.com/*"
  ],
  "action": {
    "default_title": "Testline Speed Test",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
