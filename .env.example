# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this applet is hosted (defaults to https://testline.net).
APP_URL="https://testline.net"

# Google AdSense Publisher Configuration (optional until monetization is activated)
# ADSENSE_PUBLISHER_ID is used by /ads.txt (e.g. pub-1234567890123456)
# VITE_ADSENSE_CLIENT_ID is used by the client AdSense script and account meta tag (e.g. ca-pub-1234567890123456)
# VITE_ADSENSE_SLOT_MAIN is the responsive ad unit slot ID (numeric string)
ADSENSE_PUBLISHER_ID=""
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_MAIN=""
